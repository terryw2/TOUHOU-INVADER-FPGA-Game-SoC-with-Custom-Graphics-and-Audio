function automatic logic [1:0] pic_bg_chr_pixel(input logic [5:0] tile, input logic [2:0] row, input logic [2:0] col);
    logic [15:0] row_bits;
    logic [3:0] shift;
    begin
        row_bits = pic_bg_chr_row(tile, row);
        shift = {(3'd7 - col), 1'b0};
        pic_bg_chr_pixel = (row_bits >> shift) & 2'b11;
    end
endfunction

function automatic logic [11:0] pic_bg_palette(input logic [1:0] px, input logic [5:0] tile, input logic [10:0] x, input logic [10:0] y);
    logic [11:0] c0;
    logic [11:0] c1;
    logic [11:0] c2;
    logic [11:0] c3;
    logic [11:0] c0_dim;
    begin
        c0 = bg_palette_words[0][11:0];
        c1 = bg_palette_words[1][11:0];
        c2 = bg_palette_words[2][11:0];
        c3 = bg_palette_words[3][11:0];
        c0_dim = {1'b0, c0[11:9], 1'b0, c0[7:5], 1'b0, c0[3:1]};
        unique case (px)
            2'd0: pic_bg_palette = ((x[7] ^ y[6] ^ tile[0]) != 0) ? c0_dim : c0;
            2'd1: pic_bg_palette = c1;
            2'd2: pic_bg_palette = tile[3] ? (c2 | 12'h111) : c2;
            default: pic_bg_palette = tile[2] ? (c3 | 12'h111) : c3;
        endcase
    end
endfunction
